# Mini App (Vite). Контекст сборки — корень репозитория (Railway: Root Directory пустой).
# Variables: VITE_API_BASE_URL или GUARD_API_BASE_URL (рантайм для /guard-api-config.js).
# Опционально GUARD_LOG_HTTP=1 — строка лога на каждый HTTP-запрос (отладка в Railway).
#
# Раньше здесь был `serve -s`: он НЕ подставляет URL API в рантайме — панель «молча» ломалась
# при пустом public/guard-api-config.js. Используем тот же serve-static.mjs, что и webapp/Dockerfile.
FROM node:20-alpine AS build
WORKDIR /app
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci
COPY webapp/ .
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM node:20-alpine AS run
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY webapp/serve-static.mjs ./serve-static.mjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=15s --start-period=40s --retries=5 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3000)+'/',(r)=>{r.resume();r.on('end',()=>process.exit(r.statusCode>=200&&r.statusCode<500?0:1))}).on('error',()=>process.exit(1))"
CMD ["node", "serve-static.mjs"]
