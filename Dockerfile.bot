# Образ бота: в Railway у сервиса бота задай RAILWAY_DOCKERFILE_PATH=Dockerfile.bot
# (в корне репо больше нет файла с именем Dockerfile — чтобы фронт с Root Directory=webapp не подтягивал Python-образ).
# Копия логики из docker/Dockerfile — при изменениях синхронизируйте оба файла или оставьте один источник.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

# Порт поднимается до delete_webhook и on_startup; при ошибке urllib завершит процесс с кодом ≠0.
HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=5 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8080')+'/health', timeout=8)"

CMD ["python", "-m", "app.main"]
